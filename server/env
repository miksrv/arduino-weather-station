#--------------------------------------------------------------------
# Example Environment Configuration file
#
# Copy this file to `.env` (cp env .env) and adjust the values below
# for your local setup. By default, all settings are commented out
# except the minimum needed to run the project locally against the
# docker-compose database (see config/docker-compose.yml).
#
# To override a setting, un-comment it by removing the '#' at the
# beginning of the line.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development
; CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'

app.arduino.token = ''

app.weatherapi.key     = ''
app.openweather.key    = ''
app.visualcrossing.key = ''

app.lat = 00.0000
app.lon = 00.0000

# app.narodmon.mac = ''
app.narodmon.lat = 00.0000
app.narodmon.lon = 00.0000
app.narodmon.alt = 0

# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

# Start the local database first: docker-compose -f config/docker-compose.yml up -d
database.development.hostname = 127.0.0.1
database.development.port     = 3309
database.development.database = db
database.development.username = user
database.development.password = password
database.development.DBDriver = MySQLi

# database.production.hostname = 127.0.0.1
# database.production.port     = 3306
# database.production.database = ''
# database.production.username = ''
# database.production.password = ''
# database.production.DBDriver = MySQLi

# Used automatically by PHPUnit database tests (ENVIRONMENT === 'testing').
# Points at the same docker-compose database as `development` by default.
database.tests.hostname = 127.0.0.1
database.tests.port     = 3309
database.tests.database = db
database.tests.username = user
database.tests.password = password
database.tests.DBDriver = MySQLi
database.tests.DBPrefix =
database.tests.charset  = utf8mb4
database.tests.DBCollat = utf8mb4_general_ci

